{
  "name": "@eyes22798/svg-icon",
  "version": "2.0.0",
  "author": "helox.ye",
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "types": "dist/types/svg-icon.vue.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.umd.js"
    },
    "./webpack": "./webpack/index.js",
    "./vite": "./vite/index.js"
  },
  "keywords": [
    "svg-icon",
    "svg",
    "svg-sprite",
    "vue",
    "vue3"
  ],
  "homepage": "https://github.com/Eyes22798/custom-svg-icon",
  "repository": "https://github.com/Eyes22798/custom-svg-icon.git",
  "private": false,
  "description": "a svg icon component use in vue",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:types",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "echo 'no linter configured'"
  },
  "files": [
    "dist",
    "webpack",
    "vite",
    "src/svg-icon.vue",
    "src/template-vite.js",
    "src/template-webpack.js",
    "src/index.js"
  ],
  "dependencies": {
    "ejs": "^3.1.8",
    "glob": "7.1.6",
    "svg-sprite-loader": "^6.0.11",
    "svgo-loader": "^3.0.1",
    "webpack-virtual-modules": "0.3.2"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^29.1.1",
    "sass": "^1.100.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "vue": "~3.5.35",
    "vue-tsc": "^3.3.4"
  }
}
